<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="fw-bold m-0" style="color:#1e2761;">Notifications</h3>
  <% if (notifications.some(n => n.status === 'unread')) { %>
    <form method="POST" action="/notifications/mark-read">
      <button class="btn btn-sm btn-outline-primary">Mark all as read</button>
    </form>
  <% } %>
</div>

<div class="card shadow-sm">
  <ul class="list-group list-group-flush">
    <% if (notifications.length === 0) { %>
      <li class="list-group-item text-muted text-center py-4">No notifications yet.</li>
    <% } %>
    <% notifications.forEach(n => { %>
      <li class="list-group-item d-flex justify-content-between align-items-start <%= n.status === 'unread' ? 'bg-light' : '' %>">
        <div>
          <% if (n.status === 'unread') { %><span class="badge bg-primary me-2" style="background-color:#1e2761 !important;">New</span><% } %>
          <%= n.message %>
        </div>
        <span class="small text-muted ms-3 text-nowrap"><%= n.created_at %></span>
      </li>
    <% }) %>
  </ul>
</div>

<%- include('partials/footer') %>
