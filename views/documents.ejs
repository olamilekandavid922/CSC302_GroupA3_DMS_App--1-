<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="fw-bold m-0" style="color:#1e2761;">Documents</h3>
  <% if (['admin','lawyer','paralegal'].includes(currentUser.role)) { %>
    <a href="/documents/upload" class="btn btn-sm btn-primary" style="background-color:#1e2761;border-color:#1e2761;">+ Upload Document</a>
  <% } %>
</div>

<form method="GET" action="/documents" class="card shadow-sm p-3 mb-3">
  <div class="row g-2">
    <div class="col-md-5">
      <input type="text" name="q" class="form-control" placeholder="Search by title or client name"
             value="<%= filters.q || '' %>" />
    </div>
    <div class="col-md-3">
      <input type="text" name="case_number" class="form-control" placeholder="Case number"
             value="<%= filters.case_number || '' %>" />
    </div>
    <div class="col-md-2">
      <select name="category" class="form-select">
        <option value="">All categories</option>
        <% ['contract','affidavit','pleading','correspondence','general'].forEach(cat => { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-outline-primary w-100">Search</button>
    </div>
  </div>
</form>

<div class="card shadow-sm">
  <table class="table mb-0">
    <thead><tr><th>Title</th><th>Case</th><th>Client</th><th>Category</th><th>Version</th><th>Date</th></tr></thead>
    <tbody>
      <% if (documents.length === 0) { %>
        <tr><td colspan="6" class="text-muted text-center py-3">No documents match your search.</td></tr>
      <% } %>
      <% documents.forEach(d => { %>
        <tr>
          <td><a href="/documents/<%= d.document_id %>"><%= d.title %></a></td>
          <td><%= d.case_number %></td>
          <td><%= d.client_name %></td>
          <td><span class="badge bg-light text-dark border"><%= d.category %></span></td>
          <td>v<%= d.current_version %></td>
          <td class="small text-muted"><%= d.upload_date %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
